+_FISHER_MODULE_PATTERN = re.compile(
+    r"(?:^|\.)encoder\.layer\.(\d+)\."
+    r"(attention\.self\.(?:query|key|value)|attention\.output\.dense|"
+    r"intermediate\.dense|output\.dense)$"
+)
+
+
+def _fake_quant_tensor(tensor, bits):
+    qmax = (1 << (bits - 1)) - 1
+    max_abs = tensor.detach().abs().max()
+    if max_abs.item() == 0:
+        return tensor.detach()
+    scale = max_abs / qmax
+    return torch.clamp(torch.round(tensor.detach() / scale), -qmax, qmax) * scale
+
+
+def _fisher_linear_modules(jiant_model):
+    modules = []
+    for name, module in jiant_model.named_modules():
+        match = _FISHER_MODULE_PATTERN.search(name)
+        if match and isinstance(module, torch.nn.Linear):
+            modules.append((name, int(match.group(1)), match.group(2), module))
+    modules.sort(key=lambda item: (item[1], item[2]))
+    if len(modules) != 144:
+        raise RuntimeError(f"Expected 144 BERT encoder linear modules, found {len(modules)}")
+    return modules
+
+
+def maybe_collect_fisher_sensitivity(runner):
+    output_path = os.environ.get("FISHER_STATS_PATH", "").strip()
+    if not output_path:
+        return
+    calibration_batches = int(os.environ.get("FISHER_CALIBRATION_BATCHES", "16"))
+    weight_bits = int(os.environ.get("FISHER_WEIGHT_BITS", "4"))
+    activation_bits = int(os.environ.get("FISHER_ACT_BITS", "4"))
+    if calibration_batches <= 0:
+        raise ValueError("FISHER_CALIBRATION_BATCHES must be positive")
+    task_names = runner.jiant_task_container.task_run_config.train_task_list
+    if len(task_names) != 1:
+        raise RuntimeError("Fisher collection requires exactly one train task")
+    task_name = task_names[0]
+    task = runner.jiant_task_container.task_dict[task_name]
+    train_dataloader = runner.get_train_dataloader_dict()[task_name]
+    modules = _fisher_linear_modules(runner.jiant_model)
+    stats = {}
+    pending_activation_errors = {}
+    handles = []
+
+    for name, layer, suffix, module in modules:
+        weight_error_sq = (
+            _fake_quant_tensor(module.weight, weight_bits) - module.weight.detach()
+        ).float().square()
+        stats[name] = {
+            "module_name": f"encoder.layer.{layer}.{suffix}",
+            "layer": layer,
+            "suffix": suffix,
+            "weight_values": module.weight.numel(),
+            "weight_fisher_error_sum": 0.0,
+            "weight_fisher_sum": 0.0,
+            "weight_quant_error_sum": float(weight_error_sq.sum().item()),
+            "activation_values": 0,
+            "activation_fisher_error_sum": 0.0,
+            "activation_fisher_sum": 0.0,
+            "activation_quant_error_sum": 0.0,
+        }
+        pending_activation_errors[name] = []
+
+        def capture_activation(current_module, inputs, module_name=name):
+            activation = inputs[0]
+            error_sq = (
+                _fake_quant_tensor(activation, activation_bits) - activation.detach()
+            ).float().square()
+            current = stats[module_name]
+            current["activation_values"] += activation.numel()
+            current["activation_quant_error_sum"] += float(error_sq.sum().item())
+            pending_activation_errors[module_name].append(error_sq)
+
+        def accumulate_activation(
+            current_module, gradient_inputs, gradient_outputs, module_name=name
+        ):
