+def maybe_calibrate_outlier_activations(runner):
+    calibration_batches = int(os.environ.get("PTQ_ACT_CALIBRATION_BATCHES", "0"))
+    if calibration_batches <= 0:
+        return
+    task_name_list = runner.jiant_task_container.task_run_config.train_task_list
+    if len(task_name_list) != 1:
+        raise RuntimeError(
+            "PTQ activation calibration requires exactly one configured train task"
+        )
+    task_name = task_name_list[0]
+    task = runner.jiant_task_container.task_dict[task_name]
+    train_dataloader = runner.get_train_dataloader_dict()[task_name]
+    module_count = start_outlier_activation_calibration(runner.jiant_model)
+    runner.jiant_model.eval()
+    print(
+        f"Calibrating {module_count} A-outlier modules on {calibration_batches} "
+        f"training batches for task={task_name}"
+    )
+    for _ in range(calibration_batches):
+        batch, _ = train_dataloader.pop()
+        batch = batch.to(runner.device)
+        with torch.no_grad():
+            wrap_jiant_forward(
+                jiant_model=runner.jiant_model,
+                batch=batch,
+                task=task,
+                compute_loss=False,
+            )
+    output_path = os.environ.get("PTQ_ACT_CALIBRATION_STATS_PATH", "").strip()
+    summaries = finish_outlier_activation_calibration(
+        runner.jiant_model, output_path=output_path
+    )
+    print(
+        f"Finished activation calibration: modules={len(summaries)}, "
+        f"stats={output_path or 'disabled'}"
+    )
+
